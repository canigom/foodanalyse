// KochHeute database schema.
//
// Postgres-backed. The iOS app authenticates over HTTP via JWT bearer tokens
// (issued by /api/auth/login). NextAuth's Account/Session/VerificationToken
// tables exist for browser-based OAuth flows (e.g., Google sign-in via the
// hosted login page); the credentials path doesn't touch them because we
// run JWT-strategy sessions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  // Optional — Google-only users have no password.
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())

  preferences  Preference?
  savedRecipes SavedRecipe[]
  accounts     Account[]
  sessions     Session[]
}

model Preference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g., ["vegetarisch", "glutenfrei"]
  dietary   String[]
  // e.g., ["mediterran", "asiatisch"]
  cuisines  String[]
  // free-text ingredients to avoid
  dislikes  String[]
  updatedAt DateTime @updatedAt
}

model SavedRecipe {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String
  ingredients        String[]
  steps              String[]
  cookingTimeMinutes Int
  // optional thumbnail (data URI / base64-encoded JPEG)
  imageBase64        String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// Standard NextAuth tables — used only by the Google OAuth flow.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
